      <aliases enabled='yes' />
      <column caption='Profit Margin Ratio' datatype='real' name='[Calculation_0391187442245632]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Profit] / [Sales]' />
      </column>
      <column caption='Total Revenue Before Discount' datatype='real' name='[Calculation_0391187443326977]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Sales] * [Quantity]' />
      </column>
      <column caption='Aggregate Profit Margin' datatype='real' name='[Calculation_0391187444174850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Fixed Regional Sales' datatype='real' name='[Calculation_0391187444670467]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [State] : SUM([Sales]) }' />
      </column>
      <column caption='Include Sales per Customer' datatype='real' name='[Calculation_0391187445075972]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [Customer ID] : SUM([Sales]) }' />
      </column>
      <column aggregation='Attribute' caption='Exclude Category Sales' datatype='real' name='[Calculation_0391187445391365]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [Sub-Category] : SUM([Sales]) }' />
      </column>
      <column caption='KPI Threshold Met?' datatype='string' name='[Calculation_0391187447324679]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &gt;= [Parameters].[Parameter 0391187445653510]&#13;&#10;THEN &quot;Target Achieved&quot;&#13;&#10;ELSE &quot;Below Target&quot;&#13;&#10;END' />
      </column>
      <column caption='Cleaned Discount' datatype='real' name='[Calculation_0391187453198345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Discount], 0)' />
      </column>
      <column caption='Standardized City Type' datatype='string' name='[Calculation_0391187453427722]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER([City Type])' />
      </column>
      <column datatype='string' name='[City Type]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Postal Code]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
